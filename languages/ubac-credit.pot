msgstr ""

#. translators: %s: coupon code */
#: includes/class-ubac-credit-core.php:691
msgid "Store credit %s: this order was charged on a credit that has since been deleted and recreated under the same code, so the credit now carrying that code was left alone. It is not the one that paid for this order."
msgstr ""

#. translators: %s: coupon code */
